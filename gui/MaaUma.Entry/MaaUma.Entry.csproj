<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseAppHost>true</UseAppHost>
    <AppHostDotNetSearch>AppRelative</AppHostDotNetSearch>
    <AppHostRelativeDotNet>dotnet</AppHostRelativeDotNet>
    <AssemblyName>MaaUma.Entry</AssemblyName>
    <RootNamespace>MaaUma.Entry</RootNamespace>
    <Product>MaaUma</Product>
    <Title>MaaUma</Title>
    <Description>MaaUma 启动入口</Description>
    <Version>1.0.0</Version>
    <ApplicationIcon>assets/MaaUma.ico</ApplicationIcon>
    <ApplicationManifest>launcher.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup><Compile Include="Program.cs" /></ItemGroup>
</Project>
